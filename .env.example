# Database (Postgres / Neon). Auto-provisioned by Neon Launchpad in dev.
DATABASE_URL=
DATABASE_URL_POOLER=

# Booking domain side-effects (ALLAI-6)
N8N_BOOKING_WEBHOOK_URL=

# Stripe (AutomaticAI account)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
# Generated by `stripe listen --forward-to localhost:5173/api/webhooks/stripe`
# in dev. In prod, set to the webhook endpoint's signing secret in the
# Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# Mercury Bank (used for post-launch revenue reconciliation only; not part of
# the user-facing booking flow).
MERCURY_API_TOKEN=

# Google Calendar + Meet (booking confirmations auto-create an event with a
# Meet link). Provision the refresh token once via:
#   pnpm tsx scripts/google-oauth-setup.ts
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Booking admin allow-list (comma-separated emails). Both names must be set.
# The server uses ADMIN_EMAILS to gate every admin server fn; the client uses
# VITE_ADMIN_EMAILS to render the right UI immediately. Keep them in sync.
ADMIN_EMAILS=
VITE_ADMIN_EMAILS=
